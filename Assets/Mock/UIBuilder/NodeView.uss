#node-border {
    min-width: 140px;
    background-color: rgb(45, 45, 45);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(25, 25, 25);
}

/* 組み込みGraphView USSの flex-direction / align / 余白を明示的に打ち消す */
#input, #output {
    flex-direction: column;
    align-items: center;     /* ポートを横方向の中央に */
    justify-content: center; /* ポートを縦方向の中央に */
    align-self: stretch;     /* コンテナをノード幅いっぱいに広げてから中央寄せ */
    flex-grow: 0;
    min-height: 12px;
    padding: 0;
    margin: 0;
}

/* 縦向きポートはラベルを使わないので非表示にし、コネクタ自体を中央に合わせる */
#input #type, #output #type {
    display: none;
}

#title {
    flex-direction: column;  /* 組み込みの row を上書き */
    align-items: center;
    justify-content: center;
    padding: 6px 10px;
    margin: 0;
}

/* 折りたたみボタン領域。残すとタイトルが左に押し出されてポートと軸がずれる */
#title-button-container {
    display: none;
}

#title-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    flex-grow: 0;
    margin: 0;
    padding: 0;
}

#selection-border {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    border-radius: 6px;
}

:hover > #selection-border { border-width: 1px; border-color: rgb(120, 120, 120); }
:selected > #selection-border { border-width: 2px; border-color: rgb(68, 192, 255); }

/* ノード種類ごとの色（タイトル部分） */
.action    #title { background-color: rgb(60, 110, 70); }
.composite #title { background-color: rgb(140, 100, 40); }
.decorator #title { background-color: rgb(70, 90, 150); }
.root      #title { background-color: rgb(140, 50, 50); }
.running   #node-border { border-color: rgb(255, 200, 0); border-width: 2px; }